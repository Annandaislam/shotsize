{
  "manifest_version": 3,
  "name": "ShotSize — exact-size screenshots",
  "version": "1.0.0",
  "description": "Capture the current tab at any exact pixel size, e.g. 1920x1080 or 1920x1920, regardless of your screen size.",
  "permissions": ["debugger", "downloads", "activeTab", "scripting", "storage"],
  "action": {
    "default_title": "ShotSize",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
